rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 公開サイト用: 画像は誰でも閲覧可
    // 管理画面用: ログイン済みユーザーのみアップロード可（content/ admin/ 配下）
    match /content/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /admin/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
